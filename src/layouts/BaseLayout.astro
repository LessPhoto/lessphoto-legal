---
import SEOHead from "../components/SEOHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { APP_STORE_CAMPAIGNS, copy, localeMeta, type Locale } from "../data/site";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path?: string;
  noindex?: boolean;
  applicationSchema?: boolean;
  heroHeader?: boolean;
  toolMode?: boolean;
  darkHeader?: boolean;
  frostedToolHeader?: boolean;
  darkPage?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  locale,
  path = "",
  noindex = false,
  applicationSchema = false,
  heroHeader = false,
  toolMode = false,
  darkHeader = false,
  frostedToolHeader = false,
  darkPage = false,
  hideFooter = false,
} = Astro.props;
const t = copy[locale];
const appStoreCampaign = path === "blog" || path.startsWith("blog/")
  ? APP_STORE_CAMPAIGNS.blog
  : path.startsWith("tools/")
    ? APP_STORE_CAMPAIGNS.tool
  : APP_STORE_CAMPAIGNS.product;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang} class:list={{ "dark-page-html": darkPage }}>
  <head>
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      path={path}
      noindex={noindex}
      applicationSchema={applicationSchema}
    />
  </head>
  <body class:list={{ "tool-mode-body": toolMode, "dark-page-body": darkPage }}>
    <a class="skip-link" href="#main-content">{t.skipToContent}</a>
    {!toolMode && <Header locale={locale} path={path} heroTheme={heroHeader} darkTheme={darkHeader} frostedToolTheme={frostedToolHeader} campaignToken={appStoreCampaign} />}
    <main id="main-content">
      <slot />
    </main>
    {!toolMode && !hideFooter && <Footer locale={locale} campaignToken={appStoreCampaign} />}
  </body>
</html>
