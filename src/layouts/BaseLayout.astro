---
import SEOHead from "../components/SEOHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { APP_STORE_CAMPAIGNS, copy, localeMeta, type Locale } from "../data/site";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path?: string;
  noindex?: boolean;
  applicationSchema?: boolean;
  heroHeader?: boolean;
}

const {
  title,
  description,
  locale,
  path = "",
  noindex = false,
  applicationSchema = false,
  heroHeader = false,
} = Astro.props;
const t = copy[locale];
const appStoreCampaign = path === "guides" || path.startsWith("guides/")
  ? APP_STORE_CAMPAIGNS.blog
  : APP_STORE_CAMPAIGNS.product;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      path={path}
      noindex={noindex}
      applicationSchema={applicationSchema}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.skipToContent}</a>
    <Header locale={locale} path={path} heroTheme={heroHeader} campaignToken={appStoreCampaign} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} campaignToken={appStoreCampaign} />
  </body>
</html>
