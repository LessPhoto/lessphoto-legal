---
import BaseLayout from "./BaseLayout.astro";
import AppStoreButton from "../components/AppStoreButton.astro";
import ContentFrame from "../components/ContentFrame.astro";
import { APP_STORE_CAMPAIGNS, type Locale } from "../data/site";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  category?: string;
  date?: string;
}

const { title, description, locale, path, category, date } = Astro.props;
const buttonLabel = locale === "en" ? "Get the app" : locale === "zh-hans" ? "下载 App" : "下載 App";
---

<BaseLayout title={`${title} · LessPhoto`} description={description} locale={locale} path={path}>
  <ContentFrame
    locale={locale}
    section="blog"
    active={path}
    currentLabel={title}
    currentBlogPath={path}
  >
    <article class="content-article">
      <header class="content-article__header blog-header">
        <h1>{title}</h1>
        {description && <p class="blog-dek">{description}</p>}
        {Astro.slots.has("meta") ? (
          <slot name="meta" />
        ) : (category || date) && (
          <div class="blog-meta">
            {category && <span>{category}</span>}
            {date && <time datetime={date}>{date}</time>}
          </div>
        )}
      </header>
      <div class="blog-content">
        <slot />
      </div>
      <aside class="blog-cta">
        <img
          class="blog-cta__icon"
          src="/assets/app-icon.svg"
          width="72"
          height="72"
          alt=""
          aria-hidden="true"
        />
        <div class="blog-cta__copy">
          <h2>LessPhoto</h2>
          <p>{description}</p>
        </div>
        <AppStoreButton label={buttonLabel} campaignToken={APP_STORE_CAMPAIGNS.blog} />
      </aside>
    </article>
  </ContentFrame>
</BaseLayout>
