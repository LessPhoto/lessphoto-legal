---
import BaseLayout from "./BaseLayout.astro";
import BlogCta from "../components/BlogCta.astro";
import ContentFrame from "../components/ContentFrame.astro";
import type { Locale } from "../data/site";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  category?: string;
  date?: string;
}

const { title, description, locale, path, category, date } = Astro.props;
---

<BaseLayout title={`${title} · LessPhoto`} description={description} locale={locale} path={path}>
  <ContentFrame
    locale={locale}
    section="blog"
    active={path}
    currentLabel={title}
    currentBlogPath={path}
  >
    <article class="content-article">
      <header class="content-article__header blog-header">
        <h1>{title}</h1>
        {description && <p class="blog-dek">{description}</p>}
        {Astro.slots.has("meta") ? (
          <slot name="meta" />
        ) : (category || date) && (
          <div class="blog-meta">
            {category && <span>{category}</span>}
            {date && <time datetime={date}>{date}</time>}
          </div>
        )}
      </header>
      <div class="blog-content">
        <slot />
      </div>
      <BlogCta locale={locale} />
    </article>
  </ContentFrame>
</BaseLayout>
