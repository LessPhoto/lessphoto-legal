---
import GuideArticlePage from "../../components/GuideArticlePage.astro";
import { getGuideArticles } from "../../data/guides";

export async function getStaticPaths() {
  const articles = await getGuideArticles("en");
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
---

<GuideArticlePage locale="en" article={article} />
