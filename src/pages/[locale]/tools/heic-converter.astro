---
import WebPConverter from "../../../components/WebPConverter.astro";
import { locales, type Locale } from "../../../data/site";

export function getStaticPaths() {
  return locales.filter((locale) => locale !== "en").map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<WebPConverter locale={locale} variant="heic" />
