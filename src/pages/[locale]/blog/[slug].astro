---
import BlogArticlePage from "../../../components/BlogArticlePage.astro";
import { getBlogArticles } from "../../../data/blog";
import type { Locale } from "../../../data/site";

export async function getStaticPaths() {
  const locales: Locale[] = ["zh-hans", "zh-hant"];
  const localizedArticles = await Promise.all(
    locales.map(async (locale) => ({ locale, articles: await getBlogArticles(locale) })),
  );

  return localizedArticles.flatMap(({ locale, articles }) =>
    articles.map((article) => ({
      params: { locale, slug: article.data.slug },
      props: { locale, article },
    })),
  );
}

const { locale, article } = Astro.props;
---

<BlogArticlePage locale={locale} article={article} />
