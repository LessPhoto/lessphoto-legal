---
import GuidesPage from "../../../components/GuidesPage.astro";
import type { Locale } from "../../../data/site";

export function getStaticPaths() {
  return (["zh-hans", "zh-hant"] as Locale[]).map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
---

<GuidesPage locale={locale} />
