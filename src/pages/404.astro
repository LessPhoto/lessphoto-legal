---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found – LessPhoto"
  description="The requested LessPhoto page could not be found."
  locale="en"
  noindex
>
  <section class="not-found page-width">
    <p class="eyebrow">404</p>
    <h1>That page is not here.</h1>
    <p>The address may have changed, or the page may no longer be available.</p>
    <a class="secondary-button" href="/">Return to LessPhoto</a>
  </section>
</BaseLayout>
