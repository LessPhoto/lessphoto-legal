---
import AppStoreButton from "./AppStoreButton.astro";
import { APP_STORE_CAMPAIGNS, copy, type Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const buttonLabel = locale === "en" ? "Get the app" : locale === "zh-hans" ? "下载 App" : "下載 App";
---

<aside class="blog-cta">
  <img
    class="blog-cta__icon"
    src="/assets/app-icon.svg"
    width="72"
    height="72"
    alt=""
    aria-hidden="true"
  />
  <div class="blog-cta__copy">
    <h2>LessPhoto</h2>
    <p>{copy[locale].blogCtaDescription}</p>
  </div>
  <AppStoreButton label={buttonLabel} campaignToken={APP_STORE_CAMPAIGNS.blog} />
</aside>
