---
import { APP_STORE_URL } from "../data/site";

interface Props {
  label: string;
  variant?: "primary" | "light";
  campaignToken?: string;
  providerToken?: string;
}

const { label, variant = "primary", campaignToken, providerToken } = Astro.props;
const href = campaignToken && providerToken
  ? `${APP_STORE_URL}?pt=${encodeURIComponent(providerToken)}&ct=${encodeURIComponent(campaignToken)}&mt=8`
  : APP_STORE_URL;
---

<a class:list={["app-store-button", `app-store-button--${variant}`]} href={href} target="_blank" rel="noopener">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
    <path fill="currentColor" d="M16.7 12.8c0-2.5 2.1-3.8 2.2-3.9a4.8 4.8 0 0 0-3.8-2c-1.6-.2-3.2 1-4 1-1 0-2.4-1-3.9-1-2 0-3.9 1.2-5 3.1-2.1 3.8-.5 9.3 1.5 12.3 1 1.5 2.2 3.1 3.8 3 1.5 0 2.1-1 4-1 1.8 0 2.4 1 4 1 1.6 0 2.7-1.5 3.7-3 1.2-1.7 1.7-3.4 1.7-3.5-.1 0-4.2-1.6-4.2-6ZM14 5.2A4.6 4.6 0 0 0 15 .8a4.8 4.8 0 0 0-3.2 1.5 4.4 4.4 0 0 0-1.1 3.3c1.2.1 2.4-.5 3.2-1.4Z" transform="scale(.78) translate(3 1)" />
  </svg>
  <span>{label}</span>
</a>
