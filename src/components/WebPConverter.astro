---
import { APP_STORE_CAMPAIGNS, appStoreCampaignUrl, type Locale } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { heicConverterCopy, webpConverterCopy } from "../data/tools";
import LessPhotoPromo from "./LessPhotoPromo.astro";
import ConverterTaskList from "./converter/ConverterTaskList.astro";

interface Props {
  locale: Locale;
  variant?: "webp" | "heic";
}

const { locale, variant = "webp" } = Astro.props;
const isHeic = variant === "heic";
const t = isHeic ? heicConverterCopy[locale] : webpConverterCopy[locale];
const path = isHeic ? "tools/heic-converter" : "tools/webp-converter";
const formatName = isHeic ? "HEIC" : "WebP";
const lessPhotoAppUrl = appStoreCampaignUrl(APP_STORE_CAMPAIGNS.tool);
const theme = isHeic
  ? {
      primary: "#fe6a2b",
      title: "#ff8605",
      hover: "#ec5b20",
      soft: "rgba(254, 106, 43, 0.16)",
      drop: "rgba(107, 120, 175, 0.08)",
      dropLine: "rgba(107, 120, 175, 0.12)",
      dropActive: "rgba(107, 120, 175, 0.18)",
      dragLabel: "rgba(107, 120, 175, 0.92)",
      buttonText: "white",
    }
  : {
      primary: "#216fff",
      title: "#69dcff",
      hover: "#1d63e6",
      soft: "rgba(33, 111, 255, 0.2)",
      drop: "rgba(33, 111, 255, 0.08)",
      dropLine: "rgba(33, 111, 255, 0.12)",
      dropActive: "#d6e4ff",
      dragLabel: "rgba(0, 132, 240, 0.92)",
      buttonText: "white",
    };
const themeStyle = Object.entries({
  "--webp-blue": theme.primary,
  "--webp-title-format": theme.title,
  "--webp-blue-hover": theme.hover,
  "--webp-accent-soft": theme.soft,
  "--webp-drop-bg": theme.drop,
  "--webp-drop-line": theme.dropLine,
  "--webp-drop-active": theme.dropActive,
  "--webp-drag-label-bg": theme.dragLabel,
  "--webp-button-text": theme.buttonText,
}).map(([property, value]) => `${property}:${value}`).join(";");
---

<BaseLayout title={t.seoTitle} description={t.seoDescription} locale={locale} path={path} darkHeader frostedToolHeader darkPage hideFooter>
  <div class:list={["webp-tool-page", isHeic && "heic-tool-page"]} style={themeStyle}>
    <section class="webp-tool-title page-width">
      <div class="webp-tool-title__row">
        <div class="webp-tool-title__copy">
          <h1><span class="webp-tool-title__format">{formatName}</span>{t.pageTitle.replace(new RegExp(`^${formatName}`, "i"), "")}</h1>
          <p>{t.description}</p>
        </div>
        <a class="webp-tool-inline-promo" href={lessPhotoAppUrl} target="_blank" rel="noopener">
          <span>{t.inlinePromo}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <div class="webp-tool-workspace page-width">
      <div
        class="webp-converter webp-tool-panel"
        data-webp-converter
        data-image-converter
        data-converter-kind={variant}
        data-has-scale={isHeic ? "true" : "false"}
        data-supported-extensions={JSON.stringify(t.supportedExtensions)}
        data-messages={JSON.stringify(t.messages)}
        data-png-quality-label={t.qualityLossless}
        data-download-label={t.download}
        data-failed-label={t.failed}
        data-upload-drop-title={t.dropTitle}
        data-upload-drop-hint={t.dropHint}
        data-upload-manual-label={t.manualUpload}
        data-upload-continue-label={t.continueAdding}
        data-upload-format-label={t.formatSupportShort}
          data-dimensions-label={t.dimensionsLabel}
      >
        <input
          data-file-input
          type="file"
          accept={t.inputAccept}
          multiple
          hidden
        />

        <section class="webp-tool-input">
          <div class="webp-task-header">
            <h2>{t.taskList}</h2>
            <div class="webp-task-header__actions">
              <button class="webp-text-action" data-browse-link type="button">
                <span class="webp-upload-link-icon" aria-hidden="true"></span>
                <span>{t.manualUpload}</span>
              </button>
              <button class="webp-text-action" data-clear type="button" disabled>{t.clearList}</button>
            </div>
          </div>

          <div class="webp-tool-task-surface" data-task-surface data-drag-label={t.dropTitle}>
            <ConverterTaskList />
            <div class="tool-drop-zone webp-upload-zone" data-upload-zone>
              <div class="webp-upload-copy">
                <strong data-upload-title>{t.dropTitle}</strong>
                <small data-upload-hint>{t.dropHint}</small>
                <button class="tool-primary-button tool-browse-button" data-browse type="button">
                  <img src="/assets/webp-converter/upload-plus.svg" alt="" aria-hidden="true" />
                  <span data-browse-label>{t.manualUpload}</span>
                </button>
              </div>
            </div>
          </div>

          <div class="webp-summary-bar" data-summary-bar>
            <span class="webp-summary-text" data-summary aria-live="polite">
              <span data-summary-progress>0/0 {t.completed}</span>
              <span class="webp-summary-text__separator" data-summary-separator aria-hidden="true">·</span>
              <span data-summary-saved>0 B</span>
            </span>
            <button class="tool-download-all" data-download-all type="button" disabled>
              <img src="/assets/webp-converter/download-disabled.svg" alt="" aria-hidden="true" />
              <span>{t.downloadAll}</span>
            </button>
          </div>

          <p class="tool-status webp-tool-status" data-status role="status" aria-live="polite"></p>

          <section class="tool-results" data-results-section aria-label={t.convert} hidden>
            <div class="webp-results" data-results></div>
          </section>
        </section>

        <div class="webp-tool-divider" aria-hidden="true"></div>

        <aside class="webp-tool-options">
          <div class="webp-setting">
            <h2>{t.outputFormat}</h2>
            <div class="webp-format-options" role="group" aria-label={t.outputFormat}>
              {t.outputFormats.map((format, index) => (
                <button type="button" data-format-option={format.value} class:list={[index === 0 && "is-active"]}>{format.label}</button>
              ))}
            </div>
            <select data-output-format hidden aria-hidden="true">
              {t.outputFormats.map((format, index) => (
                <option value={format.value} selected={index === 0}>{format.label}</option>
              ))}
            </select>
          </div>

          <div class="webp-setting">
            <h2>{t.quality}</h2>
            <label class="tool-field tool-quality-field">
              <div class="tool-field__label-row">
                <span><output data-quality-value>80</output><span data-quality-unit>%</span></span>
                <button class="tool-quality-reset" data-quality-reset type="button">{t.qualityReset}</button>
              </div>
              <div class="webp-range-slider" data-range-slider="quality">
                <div class="webp-range-slider__track" aria-hidden="true">
                  <span class="webp-range-slider__default-marker"></span>
                </div>
                <input data-quality type="range" min="0" max="100" step="1" value="80" />
              </div>
            </label>
          </div>

          {isHeic && (
            <div class="webp-setting heic-scale-setting">
              <h2>{t.scale}</h2>
              <label class="tool-field tool-scale-field">
                <div class="tool-field__label-row">
                  <span><output data-scale-value>1</output><span data-scale-unit>x</span></span>
                  <button class="tool-quality-reset" data-scale-reset type="button">{t.scaleReset}</button>
                </div>
                <div class="webp-range-slider" data-range-slider="scale">
                  <div class="webp-range-slider__track" aria-hidden="true">
                    <span class="webp-range-slider__default-marker"></span>
                  </div>
                  <input data-scale type="range" min="0.2" max="1" step="0.1" value="1" />
                </div>
                <p class="heic-dimensions-preview" data-dimensions-preview hidden></p>
              </label>
            </div>
          )}

          <button class="tool-primary-button webp-reconvert-button" data-reconvert type="button" disabled hidden>
            <span class="webp-reconvert-icon" aria-hidden="true"></span>
            <span>{t.reconvert}</span>
          </button>
          <button data-convert type="button" hidden aria-hidden="true">{t.convert}</button>
        </aside>
      </div>
    </div>

    <section class="webp-tool-seo page-width" aria-labelledby="webp-tool-seo-title">
      <h2 class="webp-visually-hidden" id="webp-tool-seo-title">{t.seoSectionTitle}</h2>
      <div class="webp-tool-seo-grid">
        <article class="webp-tool-seo-card">
          <h3>{t.seoSectionTitle}</h3>
          <p>{t.seoSectionDescription}</p>
        </article>
        <article class="webp-tool-seo-card">
          <h3>{t.inputFormats}</h3>
          <p>{t.inputFormatsDescription}</p>
        </article>
        <article class="webp-tool-seo-card">
          <h3>{t.privacyTitle}</h3>
          <p>{t.privacyDescription}</p>
        </article>
      </div>
    </section>

    <LessPhotoPromo title={t.ctaTitle} description={t.ctaDescription} buttonLabel={t.ctaButton} />

  </div>
</BaseLayout>

<script>
  import { zipSync } from "fflate";
  import { renderConverterTaskItems, type ConverterTaskResult } from "./converter/task-list";

  type ResultItem = ConverterTaskResult;

  const converters = document.querySelectorAll<HTMLElement>("[data-image-converter]");

  converters.forEach((converter) => {
    const fileInput = converter.querySelector<HTMLInputElement>("[data-file-input]");
    const uploadZone = converter.querySelector<HTMLElement>("[data-upload-zone]");
    const taskSurface = converter.querySelector<HTMLElement>("[data-task-surface]");
    const browseButton = converter.querySelector<HTMLButtonElement>("[data-browse]");
    const browseLink = converter.querySelector<HTMLButtonElement>("[data-browse-link]");
    const browseLabel = converter.querySelector<HTMLElement>("[data-browse-label]");
    const uploadTitle = converter.querySelector<HTMLElement>("[data-upload-title]");
    const uploadHint = converter.querySelector<HTMLElement>("[data-upload-hint]");
    const outputFormat = converter.querySelector<HTMLSelectElement>("[data-output-format]");
    const formatOptions = converter.querySelectorAll<HTMLButtonElement>("[data-format-option]");
    const quality = converter.querySelector<HTMLInputElement>("[data-quality]");
    const qualityValue = converter.querySelector<HTMLOutputElement>("[data-quality-value]");
    const qualityUnit = converter.querySelector<HTMLElement>("[data-quality-unit]");
    const qualityReset = converter.querySelector<HTMLButtonElement>("[data-quality-reset]");
    const qualitySlider = converter.querySelector<HTMLElement>('[data-range-slider="quality"]');
    const scale = converter.querySelector<HTMLInputElement>("[data-scale]");
    const scaleValue = converter.querySelector<HTMLOutputElement>("[data-scale-value]");
    const scaleReset = converter.querySelector<HTMLButtonElement>("[data-scale-reset]");
    const scaleSlider = converter.querySelector<HTMLElement>('[data-range-slider="scale"]');
    const dimensionsPreview = converter.querySelector<HTMLElement>("[data-dimensions-preview]");
    const convertButton = converter.querySelector<HTMLButtonElement>("[data-convert]");
    const clearButton = converter.querySelector<HTMLButtonElement>("[data-clear]");
    const reconvertButton = converter.querySelector<HTMLButtonElement>("[data-reconvert]");
    const status = converter.querySelector<HTMLElement>("[data-status]");
    const fileList = converter.querySelector<HTMLUListElement>("[data-file-list]");
    const summaryBar = converter.querySelector<HTMLElement>("[data-summary-bar]");
    const summary = converter.querySelector<HTMLElement>("[data-summary]");
    const summaryProgress = converter.querySelector<HTMLElement>("[data-summary-progress]");
    const summarySaved = converter.querySelector<HTMLElement>("[data-summary-saved]");
    const resultsSection = converter.querySelector<HTMLElement>("[data-results-section]");
    const resultsContainer = converter.querySelector<HTMLElement>("[data-results]");
    const downloadAllButton = converter.querySelector<HTMLButtonElement>("[data-download-all]");

    if (
      !fileInput || !uploadZone || !taskSurface || !browseButton || !browseLink || !browseLabel || !uploadTitle || !uploadHint || !outputFormat || !quality || !qualityValue || !qualityUnit || !qualityReset || !qualitySlider ||
      !convertButton || !clearButton || !reconvertButton || !status || !fileList || !summaryBar || !summary || !summaryProgress || !summarySaved || !resultsSection || !resultsContainer || !downloadAllButton
    ) return;

    const hasScale = converter.dataset.hasScale === "true";
    if (hasScale && (!scale || !scaleValue || !scaleReset || !scaleSlider || !dimensionsPreview)) return;

    const messages = JSON.parse(converter.dataset.messages || "{}") as Record<string, string>;
    const downloadLabel = converter.dataset.downloadLabel || "Download";
    const failedLabel = converter.dataset.failedLabel || "Could not convert";
    const supportedExtensions = new Set(JSON.parse(converter.dataset.supportedExtensions || "[]") as string[]);
    let selectedFiles: File[] = [];
    let results: ResultItem[] = [];
    const taskSettings = new Map<File, { format: string; quality: number; scale: number }>();
    let processingIndex = -1;
    let isConverting = false;
    let isPackaging = false;
    let conversionScheduled = false;
    let conversionTimer: number | undefined;
    let reconvertAll = true;
    const MAX_FILES = 20;
    const CONVERSION_DEBOUNCE_MS = 180;
    const MIN_PROGRESS_DURATION_MS = 500;
    let limitReached = false;
    const visualProcessing = new Map<File, { id: number; startedAt: number }>();
    const completionAnimations = new Map<File, { id: number; startedAt: number }>();
    let visualRunId = 0;
    const previewUrls = new Map<File, string>();
    const dimensions = new Map<File, { width: number; height: number }>();
    type DecodedImage = {
      width: number;
      height: number;
      image?: HTMLImageElement;
      imageBitmap?: ImageBitmap;
      imageData?: ImageData;
    };
    const decodedImages = new Map<File, DecodedImage>();
    const decodedImagePromises = new Map<File, Promise<DecodedImage>>();
    type CodecDecodeResponse =
      | { id: number; ok: true; width: number; height: number; data: ArrayBuffer }
      | { id: number; ok: false; error: string };
    let codecWorker: Worker | undefined;
    let codecRequestId = 0;
    const codecRequests = new Map<number, { resolve: (decoded: DecodedImage) => void; reject: (error: Error) => void }>();
    const getCodecWorker = () => {
      if (codecWorker) return codecWorker;
      codecWorker = new Worker(new URL("./converter/image-codec.worker.ts", import.meta.url), { type: "module" });
      codecWorker.addEventListener("message", (event: MessageEvent<CodecDecodeResponse>) => {
        const response = event.data;
        const request = codecRequests.get(response.id);
        if (!request) return;
        codecRequests.delete(response.id);
        if (response.ok) {
          request.resolve({
            width: response.width,
            height: response.height,
            imageData: new ImageData(new Uint8ClampedArray(response.data), response.width, response.height),
          });
        }
        else request.reject(new Error(response.error));
      });
      codecWorker.addEventListener("error", () => {
        codecRequests.forEach(({ reject }) => reject(new Error("Image codec worker failed")));
        codecRequests.clear();
        codecWorker = undefined;
      });
      return codecWorker;
    };
    const decodeWithCodecWorker = async (file: File, format: "heic" | "heif" | "avif") => {
      const buffer = await file.arrayBuffer();
      return new Promise<DecodedImage>((resolve, reject) => {
        const id = ++codecRequestId;
        codecRequests.set(id, { resolve, reject });
        try {
          getCodecWorker().postMessage({ id, format, buffer }, [buffer]);
        } catch (error) {
          codecRequests.delete(id);
          reject(error instanceof Error ? error : new Error(String(error)));
        }
      });
    };
    const formatMessage = (template: string, values: Record<string, string | number>) =>
      template.replace(/\{(\w+)\}/g, (_, key: string) => String(values[key] ?? ""));
    const currentScale = () => hasScale && scale ? Number(scale.value) : 1;
    const formatDimensions = (width: number, height: number, factor: number) =>
      `${Math.max(1, Math.round(width * factor))}×${Math.max(1, Math.round(height * factor))}`;
    const renderDimensionsPreview = () => {
      if (!hasScale || !scale || !dimensionsPreview) return;
      const entries = selectedFiles
        .map((file) => dimensions.get(file))
        .filter((value): value is { width: number; height: number } => !!value);
      const shouldShow = selectedFiles.length > 0 && currentScale() !== 1 && entries.length > 0;
      dimensionsPreview.hidden = !shouldShow;
      if (shouldShow) dimensionsPreview.textContent = entries
        .map((value) => formatDimensions(value.width, value.height, currentScale()))
        .join(" · ");
    };

    const formatBytes = (bytes: number) => {
      if (bytes < 1024) return `${bytes} B`;
      const units = ["KB", "MB", "GB"];
      let value = bytes / 1024;
      let unitIndex = 0;
      while (value >= 1024 && unitIndex < units.length - 1) {
        value /= 1024;
        unitIndex += 1;
      }
      return `${value.toFixed(value >= 10 ? 0 : 1)} ${units[unitIndex]}`;
    };

    const extensionFor = (name: string) => name.split(".").pop()?.toLowerCase() || "";
    const formatLabel = (format: string) => format === "jpeg" ? "JPG" : format.toUpperCase();
    const outputExtensionFor = (format: string) => format === "jpeg" ? "jpg" : format;
    const outputNameFor = (file: File, format: string) =>
      file.name.replace(/\.[^.]+$/, "") + `.${outputExtensionFor(format)}`;
    const uniqueNameFor = (name: string, usedNames: Set<string>) => {
      const extensionIndex = name.lastIndexOf(".");
      const stem = extensionIndex > 0 ? name.slice(0, extensionIndex) : name;
      const extension = extensionIndex > 0 ? name.slice(extensionIndex) : "";
      let candidate = name;
      let suffix = 2;
      while (usedNames.has(candidate.toLowerCase())) {
        candidate = `${stem} (${suffix})${extension}`;
        suffix += 1;
      }
      usedNames.add(candidate.toLowerCase());
      return candidate;
    };
    const previewUrlFor = (file: File) => {
      const existing = previewUrls.get(file);
      if (existing) return existing;
      const url = URL.createObjectURL(file);
      previewUrls.set(file, url);
      return url;
    };
    const releasePreview = (file: File) => {
      const url = previewUrls.get(file);
      if (url) URL.revokeObjectURL(url);
      previewUrls.delete(file);
    };
    const releaseDecodedImage = (file: File) => {
      decodedImages.get(file)?.imageBitmap?.close();
      decodedImages.delete(file);
      decodedImagePromises.delete(file);
    };

    const setStatus = (message: string, kind = "") => {
      status.textContent = message;
      status.dataset.kind = kind;
    };

    const revokeResults = () => {
      results.forEach((result) => {
        if (result.url) URL.revokeObjectURL(result.url);
      });
    };

    const renderSummary = () => {
      const completedCount = results.filter((result) => result.blob && selectedFiles.includes(result.file)).length;
      const savedBytes = results.reduce((total, result) => {
        if (!result.blob || !selectedFiles.includes(result.file)) return total;
        return total + result.file.size - result.blob.size;
      }, 0);
      const savedText = savedBytes > 0 ? `−${formatBytes(savedBytes)}` : formatBytes(Math.max(0, savedBytes));
      const summaryTemplate = messages.summary || "{completed}/{total} completed · {saved}";
      const separatorIndex = summaryTemplate.indexOf("·");
      const summaryValues = {
        completed: completedCount,
        total: selectedFiles.length,
        saved: savedText,
      };
      const summaryText = formatMessage(summaryTemplate, summaryValues);
      summary.setAttribute("aria-label", summaryText);
      if (separatorIndex >= 0) {
        summaryProgress.textContent = formatMessage(summaryTemplate.slice(0, separatorIndex).trim(), summaryValues);
        summarySaved.textContent = formatMessage(summaryTemplate.slice(separatorIndex + 1).trim(), summaryValues);
      } else {
        summaryProgress.textContent = summaryText;
        summarySaved.textContent = "";
      }
      summaryBar.hidden = false;
    };

    const renderFiles = () => {
      const hasFiles = selectedFiles.length > 0;
      const dropTitle = converter.dataset.uploadDropTitle || "Drop images here";
      const dropHint = converter.dataset.uploadDropHint || "";
      const manualLabel = converter.dataset.uploadManualLabel || "Choose files";
      const continueLabel = converter.dataset.uploadContinueLabel || "Continue adding";
      const formatSupportLabel = converter.dataset.uploadFormatLabel || "Supported formats";
      fileList.hidden = !hasFiles;
      taskSurface.classList.toggle("has-files", hasFiles);
      uploadZone.classList.toggle("tool-drop-zone", !hasFiles);
      uploadZone.classList.toggle("webp-add-more-zone", hasFiles);
      uploadTitle.textContent = hasFiles ? continueLabel : dropTitle;
      uploadHint.textContent = hasFiles ? formatSupportLabel : dropHint;
      browseLabel.textContent = hasFiles ? "+" : manualLabel;
      browseButton.setAttribute("aria-label", manualLabel);
      browseButton.classList.toggle("webp-upload-plus", hasFiles);
      if (hasFiles) {
        renderConverterTaskItems({
          container: fileList,
          selectedFiles,
          results,
          processingIndex,
          visualProcessing,
          completionAnimations,
          messages,
          failedLabel,
          downloadLabel,
          outputFormat: outputFormat.value,
          taskSettings,
          isPackaging,
          previewUrlFor,
          extensionFor,
          formatBytes,
          formatLabel,
          outputNameFor,
          onRemove: (file, index) => {
            if (isPackaging) return;
            const removedResult = results.find((candidate) => candidate.file === file);
            if (removedResult?.url) URL.revokeObjectURL(removedResult.url);
            releasePreview(file);
            releaseDecodedImage(file);
            dimensions.delete(file);
            taskSettings.delete(file);
            visualProcessing.delete(file);
            completionAnimations.delete(file);
            results = results.filter((candidate) => candidate.file !== file);
            selectedFiles = selectedFiles.filter((_, fileIndex) => fileIndex !== index);
            limitReached = false;
            if (processingIndex === index) processingIndex = -1;
            else if (processingIndex > index) processingIndex -= 1;
            renderFiles();
            renderResults();
          },
        });
        fileList.append(uploadZone);
      } else {
        fileList.replaceChildren();
        taskSurface.append(uploadZone);
      }

      convertButton.disabled = selectedFiles.length === 0 || isConverting;
      clearButton.disabled = isConverting || isPackaging || selectedFiles.length === 0;
      const hasFinishedResult = results.some((result) => selectedFiles.includes(result.file));
      const canReconvert = !isConverting && hasFinishedResult;
      reconvertButton.disabled = !canReconvert;
      reconvertButton.hidden = !canReconvert;
      browseLink.disabled = isConverting || isPackaging;
      renderDimensionsPreview();
      renderSummary();
    };

    const scheduleConversion = (runAll = false) => {
      if (runAll) reconvertAll = true;
      if (selectedFiles.length === 0 || isConverting || conversionScheduled) return;
      conversionScheduled = true;
      conversionTimer = window.setTimeout(() => {
        conversionTimer = undefined;
        conversionScheduled = false;
        if (selectedFiles.length > 0 && !isConverting) convertButton.click();
      }, CONVERSION_DEBOUNCE_MS);
    };

    const addFiles = (fileListToAdd: FileList | File[]) => {
      const skipped: string[] = [];
      let hitFileLimit = false;
      const existing = new Set(selectedFiles.map((file) => `${file.name}:${file.size}:${file.lastModified}`));
      Array.from(fileListToAdd).forEach((file) => {
        const extension = extensionFor(file.name);
        const key = `${file.name}:${file.size}:${file.lastModified}`;
        if (!supportedExtensions.has(extension)) {
          skipped.push(file.name);
        } else if (!existing.has(key)) {
          if (selectedFiles.length >= MAX_FILES) {
            hitFileLimit = true;
            return;
          }
          selectedFiles.push(file);
          taskSettings.set(file, { format: outputFormat.value, quality: Number(quality.value) / 100, scale: currentScale() });
          existing.add(key);
        }
      });
      limitReached = hitFileLimit;
      renderFiles();
      if (hitFileLimit) {
        setStatus(formatMessage(messages.maxFilesReached || "Limit reached: {count} images per batch. Clear the list before adding more.", { count: MAX_FILES }), "warning");
      } else if (skipped.length > 0) {
        setStatus(formatMessage(messages.unsupportedFile || "{name} is not supported.", { name: skipped[0] }), "warning");
      } else if (selectedFiles.length > 0 && !isConverting) {
        setStatus(formatMessage(messages.filesAdded || "{count} files ready", { count: selectedFiles.length }), "success");
      }
      scheduleConversion();
    };

    const loadImage = (file: Blob) => new Promise<HTMLImageElement>((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const image = new Image();
      image.decoding = "async";
      image.onload = () => {
        URL.revokeObjectURL(url);
        resolve(image);
      };
      image.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error("Image could not be decoded"));
      };
      image.src = url;
    });

    const decodeImage = (file: File): Promise<DecodedImage> => {
      const cached = decodedImages.get(file);
      if (cached) return Promise.resolve(cached);
      const pending = decodedImagePromises.get(file);
      if (pending) return pending;

      const promise = (async () => {
        const extension = extensionFor(file.name);
        let decoded: DecodedImage;
        if (extension === "heic" || extension === "heif" || extension === "avif") {
          decoded = await decodeWithCodecWorker(file, extension);
        } else {
          const image = await loadImage(file);
          decoded = { width: image.naturalWidth, height: image.naturalHeight, image };
        }
        if (!selectedFiles.includes(file)) {
          decoded.imageBitmap?.close();
        } else {
          decodedImages.set(file, decoded);
          dimensions.set(file, { width: decoded.width, height: decoded.height });
        }
        return decoded;
      })();

      decodedImagePromises.set(file, promise);
      void promise.then(
        () => decodedImagePromises.delete(file),
        () => decodedImagePromises.delete(file),
      );
      return promise;
    };

    const canvasToBlob = (canvas: HTMLCanvasElement, mime: string, qualityValueForBlob: number) =>
      new Promise<Blob>((resolve, reject) => {
        const callback = (blob: Blob | null) => blob ? resolve(blob) : reject(new Error("Image could not be encoded"));
        if (mime === "image/png") canvas.toBlob(callback, mime);
        else canvas.toBlob(callback, mime, qualityValueForBlob);
      });

    const drawDecodedImage = (decoded: DecodedImage, width: number, height: number, fillJpeg = false) => {
      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;
      const context = canvas.getContext("2d");
      if (!context) throw new Error("Canvas is not available");
      if (fillJpeg) {
        context.fillStyle = "#ffffff";
        context.fillRect(0, 0, width, height);
      }
      if (decoded.imageData) {
        const sourceCanvas = document.createElement("canvas");
        sourceCanvas.width = decoded.width;
        sourceCanvas.height = decoded.height;
        sourceCanvas.getContext("2d")?.putImageData(decoded.imageData, 0, 0);
        context.drawImage(sourceCanvas, 0, 0, width, height);
      } else if (decoded.imageBitmap) {
        context.drawImage(decoded.imageBitmap, 0, 0, width, height);
      } else if (decoded.image) {
        context.drawImage(decoded.image, 0, 0, width, height);
      }
      return canvas;
    };

    const encodeBmp = (imageData: ImageData) => {
      const { width, height, data } = imageData;
      const rowSize = width * 4;
      const pixelOffset = 54;
      const buffer = new ArrayBuffer(pixelOffset + rowSize * height);
      const view = new DataView(buffer);
      view.setUint16(0, 0x4d42, true);
      view.setUint32(2, buffer.byteLength, true);
      view.setUint32(10, pixelOffset, true);
      view.setUint32(14, 40, true);
      view.setInt32(18, width, true);
      view.setInt32(22, height, true);
      view.setUint16(26, 1, true);
      view.setUint16(28, 32, true);
      view.setUint32(34, rowSize * height, true);
      for (let y = 0; y < height; y += 1) {
        const sourceY = height - y - 1;
        for (let x = 0; x < width; x += 1) {
          const sourceIndex = (sourceY * width + x) * 4;
          const targetIndex = pixelOffset + y * rowSize + x * 4;
          view.setUint8(targetIndex, data[sourceIndex + 2]);
          view.setUint8(targetIndex + 1, data[sourceIndex + 1]);
          view.setUint8(targetIndex + 2, data[sourceIndex]);
          view.setUint8(targetIndex + 3, data[sourceIndex + 3]);
        }
      }
      return new Blob([buffer], { type: "image/bmp" });
    };

    const convertFile = async (file: File, formatValue: string, qualityForRun: number, scaleForRun: number) => {
      const extension = extensionFor(file.name);
      if (formatValue === "heic" && (extension === "heic" || extension === "heif") && scaleForRun === 1) {
        return file.slice(0, file.size, file.type || "image/heic");
      }

      const decoded = await decodeImage(file);
      dimensions.set(file, { width: decoded.width, height: decoded.height });
      renderDimensionsPreview();
      const outputWidth = Math.max(1, Math.round(decoded.width * scaleForRun));
      const outputHeight = Math.max(1, Math.round(decoded.height * scaleForRun));
      const canvas = drawDecodedImage(decoded, outputWidth, outputHeight, formatValue === "jpeg");
      const context = canvas.getContext("2d");
      if (!context) throw new Error("Canvas is not available");

      if (formatValue === "bmp") return encodeBmp(context.getImageData(0, 0, outputWidth, outputHeight));
      if (formatValue === "avif") {
        const { encode } = await import("@jsquash/avif");
        const buffer = await encode(context.getImageData(0, 0, outputWidth, outputHeight), {
          quality: Math.round(qualityForRun * 100),
        });
        return new Blob([buffer], { type: "image/avif" });
      }
      if (formatValue === "heic") {
        const nativeBlob = await canvasToBlob(canvas, "image/heic", qualityForRun).catch(() => null);
        if (nativeBlob?.type === "image/heic") return nativeBlob;
        throw new Error("HEIC output is not available in this browser");
      }

      const mime = formatValue === "png" ? "image/png" : formatValue === "jpeg" ? "image/jpeg" : "image/webp";
      const blob = await canvasToBlob(canvas, mime, qualityForRun);
      if (mime === "image/webp" && blob.type !== "image/webp") {
        throw new Error("WebP is not supported by this browser");
      }
      return blob;
    };

    const renderResults = () => {
      resultsContainer.replaceChildren();
      resultsSection.hidden = results.length === 0;
      const canDownload = !isConverting && !isPackaging && results.some((result) => result.blob);
      downloadAllButton.disabled = !canDownload;
      const downloadIcon = downloadAllButton.querySelector<HTMLImageElement>("img");
      if (downloadIcon) downloadIcon.src = canDownload
        ? "/assets/webp-converter/download-disabled.svg"
        : "/assets/webp-converter/download-disabled.svg";
      renderSummary();
    };

    const invalidateResults = () => {
      revokeResults();
      results = [];
      processingIndex = -1;
      visualProcessing.clear();
      completionAnimations.clear();
      renderFiles();
      renderResults();
    };

    const updateQualityState = () => {
      const isLossless = outputFormat.value === "png" || outputFormat.value === "bmp";
      quality.disabled = isLossless;
      qualityReset.disabled = isLossless;
      qualityValue.textContent = isLossless ? (converter.dataset.pngQualityLabel || "") : quality.value;
      qualityUnit.hidden = isLossless;
      qualitySlider.classList.toggle("is-lossless", isLossless);
      formatOptions.forEach((button) => {
        button.classList.toggle("is-active", button.dataset.formatOption === outputFormat.value);
      });
    };

    browseButton.addEventListener("click", (event) => {
      event.stopPropagation();
      fileInput.click();
    });
    browseLink.addEventListener("click", () => fileInput.click());
    let dragDepth = 0;
    taskSurface.addEventListener("dragenter", (event) => {
      event.preventDefault();
      dragDepth += 1;
      taskSurface.classList.add("is-dragging");
    });
    taskSurface.addEventListener("dragover", (event) => {
      event.preventDefault();
    });
    taskSurface.addEventListener("dragleave", (event) => {
      event.preventDefault();
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) taskSurface.classList.remove("is-dragging");
    });
    taskSurface.addEventListener("drop", (event) => {
      event.preventDefault();
      dragDepth = 0;
      taskSurface.classList.remove("is-dragging");
      addFiles(event.dataTransfer?.files || []);
    });
    fileInput.addEventListener("change", () => {
      addFiles(fileInput.files || []);
      fileInput.value = "";
    });
    const updateQualitySlider = () => {
      qualitySlider.style.setProperty("--range-percent", `${quality.value}%`);
      qualityValue.textContent = quality.value;
    };
    quality.addEventListener("input", () => {
      const value = Number(quality.value);
      if (Math.abs(value - 80) <= 3) quality.value = "80";
      updateQualitySlider();
    });
    qualityReset.addEventListener("click", () => {
      quality.value = "80";
      quality.dispatchEvent(new Event("input", { bubbles: true }));
    });
    const updateScaleSlider = () => {
      if (!hasScale || !scale || !scaleValue || !scaleSlider) return;
      const value = Number(scale.value);
      scaleValue.textContent = value === 1 ? "1" : value.toFixed(1);
      scaleSlider.style.setProperty("--range-percent", `${((value - 0.2) / 0.8) * 100}%`);
      renderDimensionsPreview();
    };
    scale?.addEventListener("input", updateScaleSlider);
    scaleReset?.addEventListener("click", () => {
      if (!scale) return;
      scale.value = "1";
      updateScaleSlider();
    });
    outputFormat.addEventListener("change", () => {
      updateQualityState();
    });
    formatOptions.forEach((button) => {
      button.addEventListener("click", () => {
        const value = button.dataset.formatOption;
        if (!value || isConverting || isPackaging) return;
        outputFormat.value = value;
        outputFormat.dispatchEvent(new Event("change", { bubbles: true }));
      });
    });
    clearButton.addEventListener("click", () => {
      revokeResults();
      previewUrls.forEach((url) => URL.revokeObjectURL(url));
      previewUrls.clear();
      selectedFiles.forEach(releaseDecodedImage);
      selectedFiles = [];
      limitReached = false;
      results = [];
      dimensions.clear();
      visualProcessing.clear();
      completionAnimations.clear();
      taskSettings.clear();
      processingIndex = -1;
      if (conversionTimer !== undefined) window.clearTimeout(conversionTimer);
      conversionTimer = undefined;
      conversionScheduled = false;
      reconvertAll = true;
      renderFiles();
      renderResults();
      setStatus("");
    });
    reconvertButton.addEventListener("click", () => {
      if (selectedFiles.length === 0 || isConverting) return;
      selectedFiles.forEach((file) => {
      taskSettings.set(file, { format: outputFormat.value, quality: Number(quality.value) / 100, scale: currentScale() });
      });
      invalidateResults();
      scheduleConversion(true);
    });
    convertButton.addEventListener("click", async () => {
      if (isConverting) return;
      if (selectedFiles.length === 0) {
        setStatus(messages.noFiles || "Choose at least one supported image.", "warning");
        return;
      }
      isConverting = true;
      const shouldResetResults = reconvertAll;
      reconvertAll = false;
      if (shouldResetResults) {
        revokeResults();
        results = [];
      }
      processingIndex = -1;
      renderFiles();
      renderResults();
      convertButton.disabled = true;
      clearButton.disabled = true;

      while (true) {
        const index = selectedFiles.findIndex((file) => !results.some((result) => result.file === file));
        if (index < 0) break;
        const file = selectedFiles[index];
        const settings = taskSettings.get(file) || { format: outputFormat.value, quality: Number(quality.value) / 100, scale: currentScale() };
        processingIndex = index;
        const currentVisualRunId = ++visualRunId;
        visualProcessing.set(file, { id: currentVisualRunId, startedAt: performance.now() });
        renderFiles();
        const completedCount = results.filter((result) => selectedFiles.includes(result.file)).length;
        setStatus(formatMessage(messages.processing || "Processing…", { current: completedCount + 1, total: selectedFiles.length }));
        const taskStartedAt = performance.now();
        try {
          const blob = await convertFile(file, settings.format, settings.quality, settings.scale);
          results.push({ file, blob, format: settings.format, url: URL.createObjectURL(blob) });
        } catch (error) {
          console.error(`Conversion failed for ${file.name}`, error);
          results.push({ file, error: true });
        }
        processingIndex = -1;
        renderFiles();
        renderResults();
        const remainingAnimation = Math.max(0, MIN_PROGRESS_DURATION_MS - (performance.now() - taskStartedAt));
        window.setTimeout(() => {
          if (visualProcessing.get(file)?.id !== currentVisualRunId) return;
          visualProcessing.delete(file);
          const completionAnimationId = ++visualRunId;
          completionAnimations.set(file, { id: completionAnimationId, startedAt: performance.now() });
          if (selectedFiles.includes(file)) {
            renderFiles();
            renderResults();
          }
          window.setTimeout(() => {
            if (completionAnimations.get(file)?.id !== completionAnimationId) return;
            completionAnimations.delete(file);
            if (selectedFiles.includes(file)) {
              renderFiles();
              renderResults();
            }
          }, 180);
        }, remainingAnimation);
      }

      results = results.filter((result) => selectedFiles.includes(result.file));
      const convertedCount = results.filter((result) => result.blob).length;
      if (limitReached) {
        setStatus(formatMessage(messages.maxFilesReached || "Limit reached: {count} images per batch. Clear the list before adding more.", { count: MAX_FILES }), "warning");
      } else {
        setStatus(formatMessage(messages.converted || "{count} files converted.", { count: convertedCount }), convertedCount ? "success" : "error");
      }
      isConverting = false;
      updateQualityState();
      renderFiles();
      renderResults();
      if (selectedFiles.some((file) => !results.some((result) => result.file === file))) scheduleConversion(reconvertAll);
    });
    downloadAllButton.addEventListener("click", async () => {
      const downloadableResults = results.filter((result) => result.blob && selectedFiles.includes(result.file));
      if (downloadableResults.length === 0 || isConverting) return;

      isPackaging = true;
      downloadAllButton.disabled = true;
      renderFiles();
      renderResults();
      setStatus(messages.packaging || "Packaging files…");
      try {
        if (downloadableResults.length === 1) {
          const result = downloadableResults[0];
          const resultFormat = result.format || outputFormat.value;
          const link = document.createElement("a");
          link.href = result.url!;
          link.download = outputNameFor(result.file, resultFormat);
          document.body.append(link);
          link.click();
          link.remove();
          setStatus(formatMessage(messages.downloaded || "Downloaded {count} file.", { count: 1 }), "success");
          return;
        }

        const usedNames = new Set<string>();
        const zipEntries: Record<string, Uint8Array> = {};
        for (const result of downloadableResults) {
          const resultFormat = result.format || outputFormat.value;
          const fileName = uniqueNameFor(outputNameFor(result.file, resultFormat), usedNames);
          zipEntries[fileName] = new Uint8Array(await result.blob!.arrayBuffer());
        }

        const zipData = zipSync(zipEntries, { level: 6 });
        const zipBlob = new Blob([zipData], { type: "application/zip" });
        const zipUrl = URL.createObjectURL(zipBlob);
        const link = document.createElement("a");
        link.href = zipUrl;
        link.download = "lessphoto-images.zip";
        document.body.append(link);
        link.click();
        link.remove();
        window.setTimeout(() => URL.revokeObjectURL(zipUrl), 1000);
        setStatus(formatMessage(messages.packaged || "{count} files packaged.", { count: downloadableResults.length }), "success");
      } catch {
        setStatus(messages.packageFailed || "Could not create the ZIP file.", "error");
      } finally {
        isPackaging = false;
        renderFiles();
        renderResults();
      }
    });

    updateQualityState();
    updateQualitySlider();
    updateScaleSlider();
    renderFiles();
  });
</script>
