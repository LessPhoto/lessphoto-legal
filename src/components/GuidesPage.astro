---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentFrame from "./ContentFrame.astro";
import { copy, guideIndexCopy, localePath, type Locale } from "../data/site";
import { guideArticles } from "../data/guides";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = guideIndexCopy[locale];
const articles = guideArticles[locale];
---

<BaseLayout title={t.seoTitle} description={t.seoDescription} locale={locale} path="guides">
  <ContentFrame locale={locale} section="guides" active="guides" currentLabel={copy[locale].navGuides} hideSidebar>
    <article class="content-article guide-index">
      <h1 class="guide-index__title">{copy[locale].navGuides}</h1>
      <div class="guide-topic-list">
        {articles.map((article, index) => (
          <a href={localePath(locale, `guides/${article.slug}`)}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{article.title}</h2>
              {article.description && <p>{article.description}</p>}
              <div class="guide-topic-meta">
                <span>{article.category}</span>
                <time datetime={article.publishedAt}>{article.publishedAt}</time>
              </div>
            </div>
          </a>
        ))}
      </div>
    </article>
  </ContentFrame>
</BaseLayout>
