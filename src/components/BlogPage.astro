---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentFrame from "./ContentFrame.astro";
import { copy, blogIndexCopy, localePath, type Locale } from "../data/site";
import { getBlogArticles } from "../data/blog";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = blogIndexCopy[locale];
const articles = await getBlogArticles(locale);
---

<BaseLayout title={t.seoTitle} description={t.seoDescription} locale={locale} path="blog">
  <ContentFrame locale={locale} section="blog" active="blog" currentLabel={copy[locale].navBlog} hideSidebar>
    <article class="content-article blog-index">
      <h1 class="blog-index__title">{copy[locale].navBlog}</h1>
      <div class="blog-topic-list">
        {articles.map((article, index) => (
          <a href={localePath(locale, `blog/${article.data.slug}`)}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{article.data.title}</h2>
              {article.data.description && <p>{article.data.description}</p>}
              <div class="blog-topic-meta">
                <span>{article.data.category}</span>
                <time datetime={article.data.publishedAt}>{article.data.publishedAt}</time>
              </div>
            </div>
          </a>
        ))}
      </div>
    </article>
  </ContentFrame>
</BaseLayout>
