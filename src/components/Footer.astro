---
import {
  APP_STORE_CAMPAIGNS,
  appStoreCampaignUrl,
  copy,
  legalLabels,
  localePath,
  type AppStoreCampaign,
  type Locale,
} from "../data/site";

interface Props {
  locale: Locale;
  campaignToken?: AppStoreCampaign;
}

const { locale, campaignToken = APP_STORE_CAMPAIGNS.product } = Astro.props;
const t = copy[locale];
const legal = legalLabels[locale];
const appStoreHref = appStoreCampaignUrl(campaignToken);
---

<footer class="site-footer">
  <div class="page-width site-footer__inner">
    <nav class="footer-groups" aria-label={t.footerNavAria}>
      <div class="footer-group">
        <p>{t.footerExplore}</p>
        <div class="footer-link-list">
          <a href={`${localePath(locale)}#features`}>{t.navFeatures}</a>
          <a href={localePath(locale, "blog")}>{t.navBlog}</a>
          <a href={appStoreHref} target="_blank" rel="noopener">{t.navGet}</a>
        </div>
      </div>
      <div class="footer-group">
        <p>{t.navAbout}</p>
        <div class="footer-link-list">
          <a href={localePath(locale, "support")}>{legal.support}</a>
          <a href={localePath(locale, "privacy")}>{legal.privacy}</a>
          <a href={localePath(locale, "terms")}>{legal.terms}</a>
        </div>
      </div>
    </nav>
    <p class="copyright">© {new Date().getFullYear()} LessPhoto</p>
  </div>
</footer>
