---
import { APP_STORE_ID, SITE_URL, localeMeta, localePath, type Locale } from "../data/site";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path?: string;
  image?: string;
  noindex?: boolean;
  applicationSchema?: boolean;
}

const {
  title,
  description,
  locale,
  path = "",
  image = "/assets/og-lessphoto.png",
  noindex = false,
  applicationSchema = false,
} = Astro.props;

const canonical = new URL(localePath(locale, path), SITE_URL);
const imageURL = new URL(image, SITE_URL);
const alternateLocales: Locale[] = ["en", "zh-hans", "zh-hant"];
const structuredData = applicationSchema
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "LessPhoto",
      operatingSystem: "iOS",
      applicationCategory: "UtilitiesApplication",
      description,
      downloadUrl: `https://apps.apple.com/app/id${APP_STORE_ID}`,
    }
  : null;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#ffffff" />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<link rel="icon" href="/assets/app-icon.svg" type="image/svg+xml" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

{alternateLocales.map((item) => (
  <link
    rel="alternate"
    hreflang={localeMeta[item].htmlLang}
    href={new URL(localePath(item, path), SITE_URL)}
  />
))}
<link rel="alternate" hreflang="x-default" href={new URL(localePath("en", path), SITE_URL)} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="LessPhoto" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageURL} />
<meta property="og:locale" content={localeMeta[locale].htmlLang.replace("-", "_")} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
