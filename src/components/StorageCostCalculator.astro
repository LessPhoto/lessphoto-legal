---
import type { Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const localized = {
  en: {
    title: "Compare your own numbers",
    description: "Choose a plan and the number of years you normally keep an iPhone. Edit the device upgrade values to match the Apple purchase page you are viewing.",
    plan: "iCloud+ plan",
    years: "How long you keep the phone",
    upgrade: "Device storage upgrade price",
    extra: "Additional device storage",
    one: "1 year",
    three: "3 years",
    five: "5 years",
    cloudTotal: "iCloud+ total",
    deviceTotal: "Device upgrade",
    perGb: "per extra GB",
    breakEven: "Same cash outlay after",
    months: "months",
    caveat: "Cost comparison only: iCloud adds syncing and cloud capacity; built-in storage adds offline capacity on one device.",
    checked: "iCloud+ presets checked against Apple pricing on September 29, 2026.",
  },
  "zh-hans": {
    title: "代入你自己的价格",
    description: "选择 iCloud+ 方案和通常使用一台 iPhone 的年限。设备容量差价可以按照你正在查看的 Apple 购买页面修改。",
    plan: "iCloud+ 方案",
    years: "预计使用这台手机",
    upgrade: "设备容量升级差价",
    extra: "增加的设备容量",
    one: "1 年",
    three: "3 年",
    five: "5 年",
    cloudTotal: "iCloud+ 累计支出",
    deviceTotal: "设备容量一次性差价",
    perGb: "每增加 1GB",
    breakEven: "累计支出相同约需",
    months: "个月",
    caveat: "这里只比较现金成本：iCloud 提供同步和云端容量；设备容量提供一台手机上的离线空间。",
    checked: "iCloud+ 预设价格已于 2026 年 9 月 29 日按照 Apple 官方定价核对。",
  },
  "zh-hant": {
    title: "代入你自己的價格",
    description: "選擇 iCloud+ 方案和通常使用一部 iPhone 的年期。裝置容量差價可以按照你正在查看的 Apple 購買頁修改。",
    plan: "iCloud+ 方案",
    years: "預計使用這部手機",
    upgrade: "裝置容量升級差價",
    extra: "增加的裝置容量",
    one: "1 年",
    three: "3 年",
    five: "5 年",
    cloudTotal: "iCloud+ 累計支出",
    deviceTotal: "裝置容量一次性差價",
    perGb: "每增加 1GB",
    breakEven: "累計支出相同約需",
    months: "個月",
    caveat: "這裡只比較現金成本：iCloud 提供同步和雲端容量；裝置容量提供一部手機上的離線空間。",
    checked: "iCloud+ 預設價格已於 2026 年 9 月 29 日按照 Apple 官方定價核對。",
  },
} as const;

const presets = {
  en: { currency: "USD", upgrade: 200, plans: [[50, 0.99], [200, 2.99], [2000, 9.99], [6000, 29.99], [12000, 59.99]] },
  "zh-hans": { currency: "CNY", upgrade: 2000, plans: [[50, 6], [200, 21], [2000, 68], [6000, 198], [12000, 398]] },
  "zh-hant": { currency: "HKD", upgrade: 1600, plans: [[50, 8], [200, 23], [2000, 78], [6000, 238], [12000, 468]] },
} as const;

const t = localized[locale];
const preset = presets[locale];
---

<section
  class="storage-calculator"
  data-storage-calculator
  data-locale={locale}
  data-currency={preset.currency}
  data-month-label={t.months}
>
  <header>
    <h2>{t.title}</h2>
    <p>{t.description}</p>
  </header>

  <div class="calculator-fields">
    <label>
      <span>{t.plan}</span>
      <select data-plan>
        {preset.plans.map(([capacity, monthly], index) => (
          <option value={monthly} data-capacity={capacity} selected={index === 1}>
            {capacity >= 1000 ? `${capacity / 1000}TB` : `${capacity}GB`} · {monthly}/{locale === "en" ? "mo" : "月"}
          </option>
        ))}
      </select>
    </label>
    <label>
      <span>{t.years}</span>
      <select data-years>
        <option value="1">{t.one}</option>
        <option value="3" selected>{t.three}</option>
        <option value="5">{t.five}</option>
      </select>
    </label>
    <label>
      <span>{t.upgrade}</span>
      <input data-upgrade type="number" min="0" step="1" value={preset.upgrade} inputmode="decimal" />
    </label>
    <label>
      <span>{t.extra}</span>
      <div class="calculator-input-unit">
        <input data-extra type="number" min="1" step="1" value="256" inputmode="numeric" />
        <span>GB</span>
      </div>
    </label>
  </div>

  <div class="calculator-results" aria-live="polite">
    <article>
      <p>{t.cloudTotal}</p>
      <strong data-cloud-total>—</strong>
    </article>
    <article>
      <p>{t.deviceTotal}</p>
      <strong data-device-total>—</strong>
      <small><span data-per-gb>—</span> {t.perGb}</small>
    </article>
    <article>
      <p>{t.breakEven}</p>
      <strong><span data-break-even>—</span> {t.months}</strong>
    </article>
  </div>

  <p class="calculator-caveat">{t.caveat}</p>
  <p class="calculator-checked">{t.checked}</p>
</section>

<script>
  const calculators = document.querySelectorAll<HTMLElement>("[data-storage-calculator]");

  calculators.forEach((calculator) => {
    const plan = calculator.querySelector<HTMLSelectElement>("[data-plan]");
    const years = calculator.querySelector<HTMLSelectElement>("[data-years]");
    const upgrade = calculator.querySelector<HTMLInputElement>("[data-upgrade]");
    const extra = calculator.querySelector<HTMLInputElement>("[data-extra]");
    const cloudTotal = calculator.querySelector<HTMLElement>("[data-cloud-total]");
    const deviceTotal = calculator.querySelector<HTMLElement>("[data-device-total]");
    const perGb = calculator.querySelector<HTMLElement>("[data-per-gb]");
    const breakEven = calculator.querySelector<HTMLElement>("[data-break-even]");
    if (!plan || !years || !upgrade || !extra || !cloudTotal || !deviceTotal || !perGb || !breakEven) return;

    const formatter = new Intl.NumberFormat(calculator.dataset.locale || "en", {
      style: "currency",
      currency: calculator.dataset.currency || "USD",
      maximumFractionDigits: 2,
    });

    const update = () => {
      const monthly = Number(plan.value) || 0;
      const yearCount = Number(years.value) || 0;
      const upgradeCost = Math.max(0, Number(upgrade.value) || 0);
      const extraStorage = Math.max(1, Number(extra.value) || 1);
      cloudTotal.textContent = formatter.format(monthly * 12 * yearCount);
      deviceTotal.textContent = formatter.format(upgradeCost);
      perGb.textContent = formatter.format(upgradeCost / extraStorage);
      breakEven.textContent = monthly > 0 ? (upgradeCost / monthly).toFixed(1) : "—";
    };

    calculator.addEventListener("input", update);
    calculator.addEventListener("change", update);
    update();
  });
</script>
