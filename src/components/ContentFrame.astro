---
import { copy, legalLabels, localePath, type Locale } from "../data/site";
import { getBlogNavigation } from "../data/blog";

type ContentSection = "blog" | "legal";

interface Props {
  locale: Locale;
  section: ContentSection;
  active: string;
  currentLabel: string;
  currentBlogPath?: string;
  hideSidebar?: boolean;
}

const { locale, section, active, currentLabel, currentBlogPath, hideSidebar = false } = Astro.props;
const t = copy[locale];
const legal = legalLabels[locale];
type NavigationItem = { key: string; label: string; href: string; publishedAt?: string };
const legalNavigation: NavigationItem[] = [
  { key: "terms", label: legal.terms, href: localePath(locale, "terms") },
  { key: "privacy", label: legal.privacy, href: localePath(locale, "privacy") },
  { key: "support", label: legal.support, href: localePath(locale, "support") },
];
const blogNavigation = section === "blog" ? await getBlogNavigation(locale) : [];
const publishedBlogNavigation = blogNavigation.map((item) => ({
  key: item.path,
  label: item.label,
  href: localePath(locale, item.path),
  publishedAt: item.publishedAt,
}));
const currentBlogIsPublished = currentBlogPath
  ? publishedBlogNavigation.some((item) => item.key === currentBlogPath)
  : false;
const navigation: NavigationItem[] = section === "legal"
  ? legalNavigation
  : [
      ...publishedBlogNavigation,
      ...(currentBlogPath && !currentBlogIsPublished
        ? [{ key: currentBlogPath, label: currentLabel, href: localePath(locale, currentBlogPath) }]
        : []),
    ];
const directoryLabel = section === "blog" ? t.blogDirectoryLabel : t.relatedInformationLabel;
---

<section class="content-shell page-width">
  {section === "blog" && currentBlogPath && (
    <a class="content-mobile-back" href={localePath(locale, "blog")}>
      <span aria-hidden="true">←</span> {t.navBlog}
    </a>
  )}

  <div class:list={["content-layout", { "content-layout--single": hideSidebar }]}>
    <div class="content-main">
      <slot />
    </div>

    {!hideSidebar && (
      <aside class:list={["content-sidebar", `content-sidebar--${section}`]}>
        <p class="content-sidebar__title">{directoryLabel}</p>
        {navigation.length > 0 ? (
          <nav aria-label={directoryLabel}>
            {navigation.map((item) => {
              const isActive = item.key === active;
              return (
              <a href={item.href} aria-current={isActive ? "page" : undefined}>
                <span>{item.label}</span>
                {section === "blog" && isActive
                  ? <small class="content-sidebar__status">{t.blogReadingLabel}</small>
                  : item.publishedAt && <time datetime={item.publishedAt}>{item.publishedAt}</time>}
              </a>
              );
            })}
          </nav>
        ) : (
          <p class="content-sidebar__empty">{t.emptyBlogDirectoryLabel}</p>
        )}
      </aside>
    )}
  </div>
</section>
