---
import { copy, legalLabels, localePath, type Locale } from "../data/site";
import { guideNavigation } from "../data/guides";

type ContentSection = "guides" | "legal";

interface Props {
  locale: Locale;
  section: ContentSection;
  active: string;
  currentLabel: string;
  currentGuidePath?: string;
  hideSidebar?: boolean;
}

const { locale, section, active, currentLabel, currentGuidePath, hideSidebar = false } = Astro.props;
const t = copy[locale];
const legal = legalLabels[locale];
type NavigationItem = { key: string; label: string; href: string; publishedAt?: string };
const legalNavigation: NavigationItem[] = [
  { key: "terms", label: legal.terms, href: localePath(locale, "terms") },
  { key: "privacy", label: legal.privacy, href: localePath(locale, "privacy") },
  { key: "support", label: legal.support, href: localePath(locale, "support") },
];
const publishedGuideNavigation = guideNavigation[locale].map((item) => ({
  key: item.path,
  label: item.label,
  href: localePath(locale, item.path),
  publishedAt: item.publishedAt,
}));
const currentGuideIsPublished = currentGuidePath
  ? publishedGuideNavigation.some((item) => item.key === currentGuidePath)
  : false;
const navigation: NavigationItem[] = section === "legal"
  ? legalNavigation
  : [
      ...publishedGuideNavigation,
      ...(currentGuidePath && !currentGuideIsPublished
        ? [{ key: currentGuidePath, label: currentLabel, href: localePath(locale, currentGuidePath) }]
        : []),
    ];
const directoryLabel = section === "guides" ? t.guideDirectoryLabel : t.navAbout;
---

<section class="content-shell page-width">
  {section === "guides" && currentGuidePath && (
    <a class="content-mobile-back" href={localePath(locale, "guides")}>
      <span aria-hidden="true">←</span> {t.navGuides}
    </a>
  )}

  <div class:list={["content-layout", { "content-layout--single": hideSidebar }]}>
    {!hideSidebar && (
      <aside class="content-sidebar">
        <p class="content-sidebar__title">{directoryLabel}</p>
        {navigation.length > 0 ? (
          <nav aria-label={directoryLabel}>
            {navigation.map((item) => (
              <a href={item.href} aria-current={item.key === active ? "page" : undefined}>
                <span>{item.label}</span>
                {item.publishedAt && <time datetime={item.publishedAt}>{item.publishedAt}</time>}
              </a>
            ))}
          </nav>
        ) : (
          <p class="content-sidebar__empty">{t.emptyGuideDirectoryLabel}</p>
        )}
      </aside>
    )}

    <div class="content-main">
      <slot />
    </div>
  </div>
</section>
