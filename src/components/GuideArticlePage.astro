---
import GuideLayout from "../layouts/GuideLayout.astro";
import StorageCostCalculator from "./StorageCostCalculator.astro";
import { render } from "astro:content";
import type { GuideArticle } from "../data/guides";
import type { Locale } from "../data/site";

interface Props {
  locale: Locale;
  article: GuideArticle;
}

const { locale, article } = Astro.props;
const { Content } = await render(article);
const path = `guides/${article.data.slug}`;
---

<GuideLayout
  title={article.data.title}
  description={article.data.description}
  locale={locale}
  path={path}
  category={article.data.category}
  date={article.data.publishedAt}
>
  {article.data.kind === "calculator" && <StorageCostCalculator locale={locale} />}
  <Content />

</GuideLayout>
