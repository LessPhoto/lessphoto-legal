---
import GuideLayout from "../layouts/GuideLayout.astro";
import StorageCostCalculator from "./StorageCostCalculator.astro";
import { guideArticles, type GuideArticle } from "../data/guides";
import { localePath, type Locale } from "../data/site";

interface Props {
  locale: Locale;
  article: GuideArticle;
}

const { locale, article } = Astro.props;
const labels = {
  en: { sources: "References", related: "Related articles" },
  "zh-hans": { sources: "参考来源", related: "相关文章" },
  "zh-hant": { sources: "參考來源", related: "相關文章" },
} as const;
const t = labels[locale];
const related = guideArticles[locale].filter((item) => item.slug !== article.slug).slice(0, 2);
const path = `guides/${article.slug}`;
---

<GuideLayout
  title={article.title}
  description={article.description}
  locale={locale}
  path={path}
  campaignToken={`guide-${article.slug}-${locale}`}
  date={article.publishedAt}
>
  {article.kind === "calculator" && <StorageCostCalculator locale={locale} />}

  {article.sections.map((section) => (
    <section>
      <h2>{section.heading}</h2>
      {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      {section.bullets && (
        <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
      )}
      {section.callout && <aside class="guide-callout">{section.callout}</aside>}
    </section>
  ))}

  <Fragment slot="after-cta">
    <section class="related-guides">
      <h2>{t.related}</h2>
      <div>
        {related.map((item) => (
          <a href={localePath(locale, `guides/${item.slug}`)}>
            <strong>{item.title}</strong>
            <time datetime={item.publishedAt}>{item.publishedAt}</time>
          </a>
        ))}
      </div>
    </section>

    <section class="guide-sources">
      <p class="guide-sources__label">{t.sources}</p>
      <ul>
        {article.sources.map((source) => (
          <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>
        ))}
      </ul>
    </section>
  </Fragment>
</GuideLayout>
